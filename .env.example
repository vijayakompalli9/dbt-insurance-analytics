# Copy to .env (git-ignored) and export before running dbt against a cloud target.
# Local DuckDB runs need none of these.

DBT_TARGET=dev
DBT_DUCKDB_PATH=warehouse/insurance.duckdb

# Snowflake (target: snowflake in profiles.example.yml)
SNOWFLAKE_ACCOUNT=your_account_locator
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=change_me
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSFORMING
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=DBT_DEV

# Databricks (target: databricks in profiles.example.yml)
DATABRICKS_HOST=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
DATABRICKS_TOKEN=change_me
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=dbt_dev
